{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "import",
          "theme",
          "source",
          "utility",
          "variant",
          "custom-variant",
          "apply",
          "plugin",
          "config",
          "reference"
        ]
      }
    ],
    "import-notation": null,
    "at-rule-no-deprecated": [
      true,
      {
        "ignoreAtRules": ["apply"]
      }
    ],
    "custom-property-pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
    "custom-property-empty-line-before": null
  },
  "ignoreFiles": ["dist/**", "coverage/**", "node_modules/**"]
}
